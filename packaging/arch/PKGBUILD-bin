# Maintainer: grimnir-sidskegg <308536721+grimnir-sidskegg@users.noreply.github.com>
#
# Binary install of iron-link from the GitHub release tarball — no Go/Flutter
# toolchain needed, only base-devel. The sibling PKGBUILD builds the same
# package from source (latest main); this one tracks tagged releases.
#
#   cp PKGBUILD-bin iron-link.install <builddir>/ && cd <builddir>
#   makepkg -si -p PKGBUILD-bin      # bump pkgver below for a new release
#
# Works from the first release that ships the linux-amd64 tarball (> v0.2.0).
# sha256sums is SKIP on purpose: the source PKGBUILD pulls the same repo over
# the same TLS with SKIP too, so a pinned hash here would add ceremony, not
# trust (release integrity is the hosting origin either way).

_pkgname=iron-link
pkgname=iron-link-bin
pkgver=0.3.0
pkgrel=1
pkgdesc="Proxy/VPN orchestrator with embedded sing-box + xray (Go daemon + Flutter client)"
arch=('x86_64')
url="https://github.com/grimnir-sidskegg/iron-link"
license=('GPL-3.0-or-later')
depends=('gtk3')
provides=('iron-link')
conflicts=('iron-link')
# Prebuilt release binaries: don't re-strip, no debug package.
options=('!strip' '!debug')
source=("$url/releases/download/v$pkgver/$_pkgname-$pkgver-linux-amd64.tar.gz")
sha256sums=('SKIP')
install="$_pkgname.install"

_libdir="/usr/lib/iron-link"

package() {
  cd "$srcdir/$_pkgname-$pkgver-linux-amd64"

  # Daemon binary.
  install -Dm755 iron-link-daemon "$pkgdir/usr/bin/iron-link-daemon"

  # Flutter GUI bundle, with a launcher symlink. The embedder resolves its
  # data/ + lib/ from the real path of /proc/self/exe, so a symlink is fine.
  install -d "$pkgdir$_libdir"
  cp -r gui/. "$pkgdir$_libdir/"
  install -d "$pkgdir/usr/bin"
  ln -s "$_libdir/iron_link_flutter" "$pkgdir/usr/bin/iron-link"

  # systemd service (root daemon, auto-start).
  install -Dm644 systemd/iron-link.service \
    "$pkgdir/usr/lib/systemd/system/iron-link.service"

  # Desktop entry + icon.
  install -Dm644 iron-link.desktop \
    "$pkgdir/usr/share/applications/iron-link.desktop"
  install -Dm644 iron-link.png \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/iron-link.png"

  # GPL-3.0 compliance: ship the license texts (the daemon embeds sing-box).
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 THIRD_PARTY_LICENSES \
    "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY_LICENSES"
}
